  "pre_join": [
   "{y}岁，拜入{s}，从外门的洒扫做起。",
   "{y}岁，走了三个月的山路到{s}山门，跪了一夜才被收下。",
   "{y}岁，过了{s}的问心阶，排在那一年的第九。",
   "{y}岁，被{s}的一位#elder#带回山门，记在外门名下。",
   "{y}岁，拜入{s}。入门那日下着雨，同来的孩子哭了一半。",
   "{y}岁，进了{s}，分到一间漏雨的小屋，和两个同门挤着住。"
  ],
  "pre_join_san": [
